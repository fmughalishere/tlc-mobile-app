<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter puts INTERNET into the debug and profile manifests only, so a
         release build of an app that talks to a server fails silently on a real
         phone unless it is also declared here. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ACCESS_NETWORK_STATE is deliberately not declared here. Nothing in the
         app's own code reads the network state (there is no connectivity
         package), and the Firebase libraries that do need it declare it in
         their own manifests, which Gradle merges in. Declaring it here as well
         only claimed a use the app does not make. -->

    <!-- Appointment reminders. Android 13+ will not show a notification without
         it, and the runtime prompt is only offered if it is declared. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="TLC Med Clinics"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Back into the app after paying by card in the phone's browser.

                 The gateway returns the patient to
                 https://tlcmedclinics.com/patient/book/result?status=...
                 With autoVerify, and assetlinks.json served from
                 https://tlcmedclinics.com/.well-known/, Android opens that
                 address in this app instead of leaving the patient on a web
                 page. lib/core/deep_links.dart handles it. Only this one path
                 is claimed: every other clinic link keeps opening in the
                 browser. If verification fails (wrong fingerprint in
                 assetlinks.json), Android simply keeps opening the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="tlcmedclinics.com"/>
                <data android:host="www.tlcmedclinics.com"/>
                <data android:pathPrefix="/patient/book/result"/>
            </intent-filter>

            <!-- Off: the link is handled by app_links in Dart. The app has no
                 route table (MaterialApp home: only), so Flutter's built-in
                 deep linking would try to push a route named
                 "/patient/book/result?..." that does not exist. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- The channel appointment notifications arrive on.
             Since Android 8 every notification belongs to a channel, and one
             that names a channel which does not exist is quietly dropped into
             "Miscellaneous" — where it is grouped with anything else and can
             be silenced without the patient realising what they silenced.
             Declaring it here makes the Firebase SDK create it on first run,
             so "Appointments" appears in the phone's own settings under this
             app and can be kept on while everything else is turned off. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tlc_appointments" />

        <!-- The status-bar icon for notifications Firebase draws itself (app
             in the background or closed). Without it Firebase falls back to
             the full-colour launcher icon, which Android reduces to a white
             square. The colour tints it in the notification shade. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- url_launcher: without these the "call the clinic" and "email us"
             buttons report that nothing can handle the link on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <!-- WhatsApp is opened as https://wa.me/..., which the https entry
             above already covers. -->
    </queries>
</manifest>
